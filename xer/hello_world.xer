main : () -> int {
    # "Hello, World!\n"
    char@ string = new char [14];
    @(string + 0) = 'H';
    @(string + 1) = 'e';
    @(string + 2) = 'l';
    @(string + 3) = 'l';
    @(string + 4) = 'o';
    @(string + 5) = ',';
    @(string + 6) = ' ';
    @(string + 7) = 'W';
    @(string + 8) = 'o';
    @(string + 9) = 'r';
    @(string + 10) = 'l';
    @(string + 11) = 'd';
    @(string + 12) = '!';
    @(string + 13) = '\n';

    for (int i = 0; i < 14; i++) {
        print(@(string + i));
    }
}